/* Make image round and add spacing */
img[alt="Guido Consonni"] {
  border-radius: 50%;
  margin: 0 1rem 1rem 0;
}

/* Simple button style for links with .btn class */
a.btn {
   margin-right: 0.5rem;
  padding: 0.5rem 0.9rem;
  border: 1px solid #ccc;
  border-radius: 0.5rem;
  text-decoration: none;
  display: inline-block;
}

/* Optional hover */
a.btn:hover {
  text-decoration: underline;
}

.bio h2 {
  margin-top: 2rem;
  padding-top: 0.75rem;
  border-top: 1px solid #eee;
}
.bio ul, .bio p { margin-bottom: 0.75rem; }
